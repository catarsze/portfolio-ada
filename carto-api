<!DOCTYPE html>
<html>
<head>
  <title>Leaflet Storymap</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@latest/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@latest/dist/leaflet.js"></script>
  
  <!-- Carregamento do plugin leaflet-providers -->
  <script src="https://unpkg.com/leaflet-providers@latest/leaflet-providers.js"></script>
  
  <style>
    #map { height: 100vh; width: 100%; }
  </style>
</head>
<body>

  <div id="map"></div>

  <script>
    // 1. Inicializa o mapa
    var map = L.map('map').setView([-25.4284, -49.2733], 13);

    // 2. Adiciona o Tile Layer com a chave de API (CartoDB.Voyager)
    L.tileLayer.provider('CartoDB.Voyager', {
      apikey: 'cb1_3g9a_1_daf34395e087ee419bcfc2f2'
    }).addTo(map);
  </script>
</body>
</html>
